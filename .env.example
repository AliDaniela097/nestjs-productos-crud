# Copia este archivo como .env y ajusta los valores.
# El archivo .env NO se sube a GitHub (esta en .gitignore).

# --- Base de datos ---
# Con docker-compose, la base queda publicada en el puerto 5433 del host
# (dentro de Docker sigue siendo 5432). Si instalaste PostgreSQL de forma
# nativa en Windows, cambia DB_PORT a 5432.
DB_HOST=localhost
DB_PORT=5433
DB_USER=nest_app
DB_PASSWORD=clave_nest
DB_NAME=productos_db

# Ponlo en true si la base esta en la nube (Azure, Neon, etc.)
DB_SSL=false

# --- Aplicacion ---
# Puerto donde escucha la API de NestJS y donde se sirve el frontend
PORT=3000
